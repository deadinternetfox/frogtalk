# ── Secrets & runtime data ─────────────────────────────────────
.env
data/
secrets/
# Runtime symlinks created by install.sh / setup wizard (not directories — need
# patterns without a trailing slash or git lists the symlink itself as untracked).
node/data
node/secrets
node/.env
# Wizard backup when replacing a real node/data directory with a symlink
node/data.misplaced-*/
*.db
*.sqlite
*.sqlite3

# ── Python ─────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
venv/
.venv/
*.egg-info/
*.egg

# ── Node / JS ──────────────────────────────────────────────────
node_modules/
client/desktop/app/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Flatpak (maintained out-of-tree / Flathub) ─────────────────
flatpak/

# ── Build outputs ──────────────────────────────────────────────
dist/
build/
*.log
deploy.tar.gz
*.tar.gz
node/builds/
# Desktop packaging output (multi-GB artifacts; keep only the README)
client/desktop/builds/*
!client/desktop/builds/README.md

# ── Release binaries (served at runtime, not stored in git) ────
node/static/*.AppImage
node/static/*.deb
node/static/*.apk
node/static/*.exe
node/static/*.zip
node/static/frogtalk-v*.apk
node/static/frogtalk_*.deb
node/static/FrogTalk-*.AppImage
node/static/FrogTalk-*-win-x64.zip
node/static/uploads/

# ── IDE & OS ───────────────────────────────────────────────────
.DS_Store
.vscode/
.vscode/*
.idea/
*.swp
*.swo
*~
Thumbs.db
desktop.ini
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Frog Channel board runtime data (node/board/) ────────────────
node/board/board_uploads/
node/board/board_data/
node/board/board_previews/
node/board/.env

# ── FrogTalk runtime ───────────────────────────────────────────
uvicorn.log
frogtalk.log
/logs/
*.tmp
/tmp_*

# ── Android ────────────────────────────────────────────────────
client/mobile/android/app/build/
client/mobile/android/build/
client/mobile/android/.gradle/
client/mobile/android/local.properties
client/mobile/android/signing.properties
client/mobile/android/app/google-services.json
client/mobile/android/frogtalk.keystore
*.apk
*.aab

# ── Build mirror (binaries published to GitHub) ────────────────
# Mirror the Android APK + AAB here as long as they fit GitHub's free per-file
# limit (<100 MB). Genuinely-too-large desktop binaries are excluded (see below)
# and served from the nodes instead.
!github-build-mirror/*.apk
!github-build-mirror/*.aab

# ── Desktop release artifacts (too large for git) ──────────────
client/desktop/builds/*.AppImage
client/desktop/builds/*.deb
client/desktop/builds/*.exe
client/desktop/builds/*.zip
client/desktop/builds/linux-unpacked/

# ── tmp deploy / ship scripts and logs (not part of repo) ──────
.tmp_*.sh
.tmp_*.log
node/scripts/.env
node/scripts/deploy_nodes.local.sh
node/scripts/deploy_fleet.local.sh
node/scripts/pin_federation_peer_keys.sh
node/scripts/sync_tor_mirror_from_main.sh
node/scripts/reset_travel_nodes.sh
node/scripts/deploy_nodes.sh
node/scripts/deploy_board.sh
# Internal fleet-ops helpers — hardcode the production fleet (IPs/roles) and
# require gitignored deploy_fleet.local.sh; never publish.
node/scripts/apply_fleet_board_identity.sh
node/scripts/sync_board_peers_fleet.sh
# Internal engineering roadmap — spotlights an in-progress hardening item; keep local.
docs/csp-migration.md

# Internal operator / planning docs (not for public repo)
docs/internal/

# Local node homepage variants (operator-only, not on GitHub)
Node Pages/
